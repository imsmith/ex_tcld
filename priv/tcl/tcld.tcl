# tcld.tcl — emit Tcl data documents that ExTcld can read.
#
# This package is deliberately tiny, because Tcl already does the hard part.
# The `list` and `dict create` commands emit canonical Tcl list form, and
# ExTcld reads that form faithfully — verified in both directions against
# tclsh in ExTcld.ConformanceTest. There is no quoting logic here and there
# should never be any: hand-rolled quoting is how the two sides drift apart.
#
# What Tcl lacks is the document level. `puts [list a b]` gives you a bare
# list, not a `set NAME VALUE` file. That is the entire gap this fills.
#
# Usage:
#
#   source tcld.tcl
#
#   tcld::begin
#   tcld::comment "generated by interrogate at [clock format [clock seconds]]"
#   tcld::set name    "mytool"
#   tcld::set effect  "read-only"
#   tcld::set args    [list --verbose --json]
#   tcld::set meta    [dict create lang tcl lines 240]
#   puts [tcld::render]
#
# Produces:
#
#   # generated by interrogate at ...
#   set name mytool
#   set effect read-only
#   set args {--verbose --json}
#   set meta {lang tcl lines 240}
#
# Read back with:
#
#   {:ok, doc} = ExTcld.parse(source)
#   {:ok, args} = ExTcld.Document.fetch(doc, "args") |> elem(1) |> ExTcld.List.from()
#   {:ok, meta} = ExTcld.Document.fetch(doc, "meta") |> elem(1) |> ExTcld.Dict.from()

package provide tcld 0.1.0

namespace eval ::tcld {
    variable body {}

    namespace export begin comment set render reset assign
}

# Start (or restart) a document.
proc ::tcld::begin {} {
    variable body
    ::set body {}
    return
}

# Alias for begin, for callers that prefer the name.
proc ::tcld::reset {} {
    ::tcld::begin
}

# Append a comment line. The text is emitted verbatim after "# "; newlines in
# it would break the document, so they are replaced with spaces.
proc ::tcld::comment {text} {
    variable body
    ::set flat [string map [list "\n" " " "\r" " "] $text]
    lappend body "# $flat"
    return
}

# Append a `set NAME VALUE` line.
#
# Quoting is delegated entirely to Tcl's own [list], which is the reference
# implementation of the format. Do not replace this with manual brace-wrapping:
# values containing braces, backslashes, quotes or whitespace each need
# different treatment, and [list] already gets all of them right.
proc ::tcld::set {name value} {
    variable body
    lappend body "set [list $name] [list $value]"
    return
}

# Explicit alias, since ::tcld::set shadows a very familiar command name and
# some callers will prefer not to rely on namespace resolution.
proc ::tcld::assign {name value} {
    ::tcld::set $name $value
}

# Render the accumulated document as a string.
proc ::tcld::render {} {
    variable body
    return [join $body "\n"]
}
